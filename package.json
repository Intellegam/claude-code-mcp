{
  "name": "claude-code-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an external agent (e.g. OpenAI Codex) consult Claude Code as a second-opinion agent",
  "main": "server.js",
  "type": "module",
  "bin": {
    "claude-code-mcp": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "check": "for f in server.js lib/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/tier1/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=240000 test/tier2/*.test.mjs",
    "test:smoke": "node test/smoke.js",
    "send": "node test/send.js"
  },
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "codex",
    "ai"
  ],
  "author": "Claude & Hannes",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220"
  }
}
